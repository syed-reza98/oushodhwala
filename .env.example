# MySQL (XAMPP local)
DATABASE_URL="mysql://oushodhwala:CHANGE_ME@127.0.0.1:3306/oushodhwala"
# Optional socket form if TCP/SSL fails on XAMPP:
# DATABASE_URL="mysql://oushodhwala:CHANGE_ME@localhost/oushodhwala?socket=/opt/lampp/var/mysql/mysql.sock"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# App
PUBLIC_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./storage/uploads"
UPLOAD_PUBLIC_BASE="/uploads"

# Storage driver: local (default) | s3 | r2
STORAGE_DRIVER="local"
# S3 / Cloudflare R2 (when STORAGE_DRIVER=s3|r2)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Email (password reset). Prefer Resend; without it, links log to server console.
# EMAIL_FROM="Oushodhwala <noreply@yourdomain.com>"
# RESEND_API_KEY=

# Optional E2E override (defaults to http://127.0.0.1:3000)
# E2E_BASE_URL="http://127.0.0.1:3030"

# AI gateway (server only)
LOVABLE_API_KEY=""
